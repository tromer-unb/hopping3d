{
  "calculation": "first_passage",
  "structure": {
    "file": "graphene_li.cif",
    "repeat": [1, 1, 1]
  },
  "graph": {
    "cutoff_A": 3.5
  },
  "transport": {
    "direction": "X",
    "temperature_K": 300,
    "xi0_A": 3.0,
    "nu0_Hz": 1e13,
    "voltages_V": [0.02, 0.05, 0.10],
    "n_trajectories": 500,
    "max_time_s": 5e-10,
    "max_steps": 5000,
    "pair_scales": {
      "C-C": 1.0,
      "C-Li": 0.2,
      "Li-Li": 0.02
    }
  },
  "chemistry": {
    "site_offsets_eV": {
      "C": 0.0,
      "Li": -0.20
    }
  },
  "random_seed": 1234,
  "output": {
    "directory": "results",
    "record_paths": 20,
    "path_voltage_V": 0.10,
    "title": "Graphene + Li template"
  }
}
